# --- AWS / region ---
AWS_REGION=us-east-1

# --- Agent (AgentCore Runtime container) ---
# Cross-region inference profile for Nova 2 Lite (verify with list-inference-profiles)
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Knowledge Base created in the console (milestone: KB on OpenSearch Serverless)
KB_ID=
RETRIEVE_TOP_K=6
# Guardrail (leave blank until you create one; then fill both)
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
# Agent loop safety caps
MAX_SUBAGENT_CALLS=8          # max sub-agent calls the orchestrator may make per request
MODEL_MAX_TOKENS=1200
# (wall-clock per request is bounded by the worker's AGENT_INVOKE_TIMEOUT + the SQS visibility timeout)

# --- Orchestrator + worker (ECS) ---
JOBS_TABLE=analyst-jobs
JOBS_QUEUE_URL=
# Runtime ARN from the AgentCore console after you create the Runtime
AGENT_RUNTIME_ARN=
# Filings bucket the Knowledge Base points at
FILINGS_BUCKET=
# Synchronous invoke read-timeout (seconds); keep <= the SQS visibility timeout
AGENT_INVOKE_TIMEOUT=900

# --- local only: LocalStack endpoint (leave blank in AWS) ---
AWS_ENDPOINT_URL=
# The agent keeps Bedrock/KB on real endpoints but writes progress to DynamoDB — point just its
# DynamoDB client at LocalStack locally (blank in AWS). The agent also reads JOBS_TABLE (above).
DDB_ENDPOINT_URL=
